# ══════════════════════════════════════════════
#  ISL Chat App — environment template
#  Copy to .env and fill in your values
# ══════════════════════════════════════════════

# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (SQLite default; set USE_SUPABASE=True for Postgres) ──
USE_SUPABASE=False
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# ── Gemini LLM (FREE) ─────────────────────────────────────────────
# Get key: https://aistudio.google.com/apikey  (no credit card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TTS_MODEL=gemini-2.0-flash-preview-tts

# ── Firebase Auth (optional — leave blank for simulation mode) ────
# Download service account JSON from Firebase Console
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_API_KEY=

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-jwt-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Misc ─────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5
CONFIDENCE_THRESHOLD=0.75
OLLAMA_BASE_URL=http://localhost:11434
