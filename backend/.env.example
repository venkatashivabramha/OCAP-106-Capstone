# ISL Chat App - copy to .env and fill in values
SECRET_KEY=your-secret-key-50-chars-minimum
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Gemini AI (FREE) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TTS_MODEL=gemini-2.0-flash-preview-tts

# Firebase - path to service account JSON
FIREBASE_SERVICE_ACCOUNT_KEY=path/to/firebase-service-account.json

# Database (SQLite default, PostgreSQL for production)
USE_SUPABASE=False
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
